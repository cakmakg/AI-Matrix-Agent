{
  "name": "📧 E-Mail Klassifizierer — AI Orchestra",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "newEmail",
        "options": {}
      },
      "id": "email_trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [240, 300],
      "credentials": {
        "gmailOAuth2": "gmail_oauth"
      }
    },
    {
      "parameters": {
        "jsCode": "// E-Mail-Daten normalisieren und für AI Brain vorbereiten\nconst item = items[0].json;\nreturn [{\n  json: {\n    platform:      'gmail',\n    platform_id:   item.id || item.messageId || '',\n    author:        item.from || '',\n    author_email:  item.from || '',\n    subject:       (item.subject || 'Kein Betreff').replace(/^(Re:|Fwd:|AW:)/i, '').trim(),\n    content:       (item.body || item.snippet || '').substring(0, 3000),\n    gmailThreadId: item.threadId || '',\n    timestamp:     new Date().toISOString()\n  }\n}];"
      },
      "id": "normalize_email",
      "name": "E-Mail normalisieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "={{$env.AI_BRAIN_URL}}/api/inbox",
        "requestMethod": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type",     "value": "application/json" },
            { "name": "X-Api-Key",        "value": "={{$env.AI_BRAIN_API_KEY}}" },
            { "name": "X-Webhook-Secret", "value": "={{$env.N8N_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "platform",      "value": "={{$json.platform}}" },
            { "name": "platform_id",   "value": "={{$json.platform_id}}" },
            { "name": "author",        "value": "={{$json.author}}" },
            { "name": "author_email",  "value": "={{$json.author_email}}" },
            { "name": "subject",       "value": "={{$json.subject}}" },
            { "name": "content",       "value": "={{$json.content}}" },
            { "name": "gmailThreadId", "value": "={{$json.gmailThreadId}}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "send_to_ai_brain",
      "name": "An AI Brain senden → /api/inbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [760, 300]
    },
    {
      "parameters": {
        "jsCode": "// AI Brain-Antwort auswerten\nconst item = items[0].json;\nconst status = item.status || 'UNKNOWN';\nreturn [{ json: { ...item, internal_status: status } }];"
      },
      "id": "parse_response",
      "name": "Antwort auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.internal_status}}", "operation": "equals", "value2": "AWAITING_HUMAN_APPROVAL_SUPPORT" },
            { "value1": "={{$json.internal_status}}", "operation": "equals", "value2": "PROCESSING" },
            { "value1": "={{$json.status}}",           "operation": "equals", "value2": "DUPLICATE" }
          ]
        }
      },
      "id": "status_switch",
      "name": "Status-Verzweigung",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "requestMethod": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id",    "value": "={{$env.TELEGRAM_CHAT_ID}}" },
            { "name": "text",       "value": "🎫 *Neues Support-Ticket* (Gmail)\n\n*Von:* {{$json.from}}\n*Kategorie:* {{$json.category}}\n*Priorität:* {{$json.priority}}\n*Ticket-ID:* {{$json.ticketId}}\n\nBitte im Dashboard prüfen und freigeben." },
            { "name": "parse_mode", "value": "Markdown" }
          ]
        },
        "options": {}
      },
      "id": "notify_support_ticket",
      "name": "📱 Telegram: Support-Ticket benachrichtigen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1540, 180]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "requestMethod": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id",    "value": "={{$env.TELEGRAM_CHAT_ID}}" },
            { "name": "text",       "value": "🔥 *Heißer Lead erkannt* (Gmail)\n\n*Von:* {{$json.from}}\n*Betreff:* {{$json.subject}}\n*Thread-ID:* {{$json.threadId}}\n\nAI Orchestra verarbeitet diesen Lead gerade..." },
            { "name": "parse_mode", "value": "Markdown" }
          ]
        },
        "options": {}
      },
      "id": "notify_hot_lead",
      "name": "🔥 Telegram: Hot Lead benachrichtigen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1540, 360]
    },
    {
      "parameters": {},
      "id": "ignore_duplicate",
      "name": "Duplikat ignorieren",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1540, 540]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [[{ "node": "E-Mail normalisieren", "type": "main", "index": 0 }]]
    },
    "E-Mail normalisieren": {
      "main": [[{ "node": "An AI Brain senden → /api/inbox", "type": "main", "index": 0 }]]
    },
    "An AI Brain senden → /api/inbox": {
      "main": [[{ "node": "Antwort auswerten", "type": "main", "index": 0 }]]
    },
    "Antwort auswerten": {
      "main": [[{ "node": "Status-Verzweigung", "type": "main", "index": 0 }]]
    },
    "Status-Verzweigung": {
      "main": [
        [{ "node": "📱 Telegram: Support-Ticket benachrichtigen", "type": "main", "index": 0 }],
        [{ "node": "🔥 Telegram: Hot Lead benachrichtigen",        "type": "main", "index": 0 }],
        [{ "node": "Duplikat ignorieren",                          "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.0.0",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "notes": "Verarbeitet eingehende Gmail-E-Mails. Sendet normalisierte Daten an AI Brain (/api/inbox). AI Brain klassifiziert eigenständig (kein externer LLM in n8n benötigt). Benachrichtigungen per Telegram je nach Ergebnis."
}
