# AI ORCHESTRA - ENVIRONMENT VARIABLES TEMPLATE
# Bu dosyayı '.env' olarak kopyalayın ve kendi API anahtarlarınızı girin.

# Express.js Server Port
PORT=4000

# AWS Bedrock Credentials (LLM Modelleri İçin)
AWS_REGION="eu-central-1" # Kendi bölgenizi yazın (örn: eu-central-1, us-east-1)
AWS_ACCESS_KEY_ID="BURAYA_AWS_ACCESS_KEY_G"
AWS_SECRET_ACCESS_KEY="BURAYA_AWS_SECRET_KEY_"

# Discord Webhook (opsiyonel)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/BURAYA_WEBHOOK_URL"

# ── Telegram Bot ──
# 1) @BotFather'dan yeni bot yarat → token al
# 2) Bota bir mesaj gönder → @userinfobot ile chat_id öğren
TELEGRAM_BOT_TOKEN="BURAYA_BOT_TOKEN"
TELEGRAM_CHAT_ID="BURAYA_CHAT_ID"

# ── WhatsApp (Twilio Sandbox) ──
# 1) twilio.com → Console → Messaging → WhatsApp Sandbox
# 2) Sandbox numarasına "join <kelime>" gönder (aktivasyon)
TWILIO_ACCOUNT_SID="BURAYA_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="BURAYA_AUTH_TOKEN"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+90XXXXXXXXXX"

# ── Google Sheets CRM ──
# HOT_LEAD'leri otomatik kaydetmek için kullanılır.
# Sheet URL'si: https://docs.google.com/spreadsheets/d/BURAYA_ID/edit
# İlk satıra şu başlıkları ekle: Tarih | Saat | Kaynak | Kimden | Konu | Özet | Thread ID | Durum
# "HOT_LEADS" adında bir sekme (sheet) oluştur.
# Gmail OAuth2 credential'larının Sheets API erişimi de olmalı.
GOOGLE_SHEETS_ID="BURAYA_SPREADSHEET_ID"

# ── n8n Entegrasyonu ──
# n8n'nin "Gidiş Köprüleri" — Node.js buraya POST eder, n8n doğru kanala iletir.
#
# Publisher (onaylanan rapor → Telegram/Slack/Discord/vb.)
N8N_PUBLISH_WEBHOOK="http://localhost:5678/webhook/publish"
#
# Support reply (onaylanan ticket yanıtı → Gmail/Slack/vb.)
N8N_REPLY_WEBHOOK="http://localhost:5678/webhook/reply"
#
# Webhook güvenlik sırrı — n8n ve Node.js aynı değeri kullanır.
# n8n Variables menüsünde: N8N_WEBHOOK_SECRET = bu değer
N8N_WEBHOOK_SECRET=""

# ── Twitter / X v2 API ──
# developer.twitter.com → Projects & Apps → Keys and Tokens
TWITTER_API_KEY="BURAYA_API_KEY"
TWITTER_API_SECRET="BURAYA_API_SECRET"
TWITTER_BEARER_TOKEN="BURAYA_BEARER_TOKEN"
# Kullanıcı hesabı bağlantısı için OAuth 1.0a access token (connectAccount endpoint'i ile kaydedilir)
# TWITTER_ACCESS_TOKEN ve TWITTER_ACCESS_TOKEN_SECRET → /api/social/accounts/connect ile DB'ye kaydedilir

# ── Twitter Otomatik İçerik Üretimi ──
# Virgülle ayrılmış konu listesi — her gün bu konular için AI tweet üretilir
TWITTER_AUTO_TOPICS="AI agents 2026, Claude Code gelişmeleri, Web3 trendleri"
# Günlük tweet üretiminin başlayacağı saat (0-23, varsayılan: 7 = sabah 07:00)
TWITTER_POST_HOUR=7
# Konu başına üretilecek tweet sayısı (varsayılan: 3)
TWITTER_TWEETS_PER_TOPIC=3

# ── Twitter Kişilik & Ton Ayarları ──
# Sen kimsin? AI bu kimliğe göre tweet yazar.
TWITTER_PERSONA="Ein in der KI- und Technologiebranche tätiger, unternehmerisch denkender Entwickler, der in der Türkei lebt. Ich entwickle Multi-Agenten-Systeme und arbeite nach dem „Build in Public“-Prinzip.."
# Nasıl yazıyorsun? Ses tonun nedir?
TWITTER_VOICE="aufrichtig, zum Nachdenken anregend, bisweilen provokativ und mutig, ausgehend von persönlichen Beobachtungen, verbindend, wahrhaftig, inspirierend, manchmal humorvoll, mit einem Hauch von Sarkasmus, stets mit dem Ziel, Diskussionen anzuregen und zum Nachdenken zu bringen."
# Dil tercihi: tr (Türkçe) | de (Almanca) | en (İngilizce) | mixed (Türkçe+İngilizce karışık)
TWITTER_LANG=de
# Tweet başına maksimum hashtag sayısı (0 = hiç hashtag yok, önerilir: 1)
TWITTER_HASHTAGS=0

# Düşünce lideri / Thought leader:


# TWITTER_PERSONA="10 yıllık yazılım geliştirici, şu an AI startup kuruyorum"
 TWITTER_VOICE="ehrlich, manchmal streng, der die Realitäten der Branche offen anspricht, der aus Erfahrungen lerntt, der sowohl Erfolge als auch Misserfolge teilt, der die Community ermutigt, sich gegenseitig zu unterstützen und gemeinsam zu wachsen"
# Build in public:


# TWITTER_PERSONA="AI ajan sistemi inşa eden indie hacker, Türkiye'den"
 TWITTER_VOICE="ehrlich, manchmal streng, der die Realitäten der Branche offen anspricht, der aus Erfahrungen lerntt, der sowohl Erfolge als auch Misserfolge teilt, der die Community ermutigt, sich gegenseitig zu unterstützen und gemeinsam zu wachsen"
# Build in public:


# TWITTER_PERSONA="Claude ve LangGraph ile çalışan full-stack AI geliştirici"
 TWITTER_VOICE="technisch, aber in einer Sprache, die jeder versteht, neugierig machend, mit Aha-Momenten, die die Möglichkeiten von KI aufzeigen, inspirierend, mit einem Fokus darauf, wie KI das Leben und die Arbeit verbessern kann, manchmal mit einem humorvollen Blick auf die Herausforderungen der KI-Entwicklung"



# ── LinkedIn API ──
# linkedin.com/developers → Create App → OAuth 2.0 Credentials
# Gerekli izinler: w_member_social, r_liteprofile
# Access token → /api/social/accounts/connect ile DB'ye kaydedilir

# ── Instagram / Facebook Meta Business API ──
# developers.facebook.com → My Apps → Add Product → Instagram Graph API / Facebook Login
# 1. Facebook App oluştur (Business türünde)
# 2. Instagram Business Account'u Facebook Sayfasına bağla
# 3. Page Access Token al (uzun süreli)
# 4. Instagram Business Account ID (pageId) → Graph API Explorer'dan: /me/accounts
# Access token ve pageId → /api/social/accounts/connect ile DB'ye kaydedilir

# ── Google Ads API ──
# developers.google.com/google-ads/api/docs/get-started
# 1. Google Ads Manager hesabı oluştur
# 2. OAuth2 Credentials → Client ID + Secret
# 3. Developer Token → Google Ads hesap ayarlarından al
GOOGLE_ADS_DEVELOPER_TOKEN="BURAYA_DEVELOPER_TOKEN"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="BURAYA_MCC_CUSTOMER_ID"
GOOGLE_ADS_DEFAULT_URL="https://example.com"
GOOGLE_ADS_DEFAULT_AD_GROUP=""
# Access token → /api/social/accounts/connect ile DB'ye kaydedilir (customerId ile birlikte)